# Database
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=radiotrace

# City focus (Atlanta)
CITY=Atlanta
CITY_STATE=GA
CITY_CENTER_LAT=33.7490
CITY_CENTER_LNG=-84.3880

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE=https://api.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v1

# SpaceX AI / xAI Grok
XAI_API_KEY=
SPACEX_AI_API_KEY=
XAI_API_BASE=https://api.x.ai/v1
SPACEX_AI_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# Google Maps Geocoding
GOOGLE_MAPS_API_KEY=

# Broadcastify
