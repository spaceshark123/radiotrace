# database
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=radiotrace

# City focus (Atlanta)
CITY=Atlanta
CITY_STATE=GA
CITY_CENTER_LAT=33.7490
CITY_CENTER_LNG=-84.3880

# ElevenLabs (speech-to-text on prerecorded clips)
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE=https://api.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v1

# SpaceX AI / xAI Grok
XAI_API_KEY=
SPACEX_AI_API_KEY=
XAI_API_BASE=https://api.x.ai/v1
SPACEX_AI_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-3-mini

# Google Maps (Geocoding on the backend, Maps JavaScript on the frontend)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
# the above two should have the same value
VITE_GOOGLE_MAP_ID=
VITE_API_BASE=/api

# Broadcastify (Atlanta police radio)
BROADCASTIFY_API_KEY=
BROADCASTIFY_API_BASE=https://api.broadcastify.com
BROADCASTIFY_FEED_ID=394
BROADCASTIFY_STREAM_URL=

HTTP_TIMEOUT_SECONDS=20
